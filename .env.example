# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port where the web server listens (default: 3000).
PORT="3000"

# APP_URL: Public URL where your website is hosted.
APP_URL="MY_APP_URL"

# Optional: Resend API key for sending real 6-digit verification emails.
# If omitted, verification codes can still be tested via the built-in local inbox preview.
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM="NixoraAI Helper <noreply@tudominio.com>"
